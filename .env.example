# ספק מקומי OpenAI-compatible; בחירת מודל אינה משנה את הגדרות השרת.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=http://<MAC_LAN_IP>:1234/v1
LLM_MODEL=qwen/qwen3.5-35b-a3b
AGENT_PORT=8710
QDRANT_URL=http://127.0.0.1:8733
STORE_PATH=data/store/sources.jsonl
APP_LIBRARY_STORE_PATH=data/store/app-library/sources.jsonl
APP_LIBRARY_DB_PATH=data/store/app-library/library.sqlite3
WEB_STORE_PATH=data/store/web/sources.jsonl
# שרת SearxNG חינמי שכבר הוגדר, רשות; אין התקנה או פריסה אוטומטית.
# SEARXNG_URL=http://127.0.0.1:8780
# WEB_PERMISSIONS_PATH=data/web-permissions.local.json

# זהות Embeddings נפרדת לחלוטין ממודל התשובות. mock אינו חיפוש סמנטי אמיתי.
EMBEDDINGS_PROVIDER=mock
EMBEDDINGS_MODEL=hash-trigram-v1
EMBEDDINGS_DIMENSIONS=128
EMBEDDINGS_REVISION=1
